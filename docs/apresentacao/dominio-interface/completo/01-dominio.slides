        <tr><td>TokenPersonalRepository</td><td>{{rs core/domain/contracts/ciclo.ts :: export interface TokenPersonalRepository}}</td></tr>
        <tr><td>SessionStorage</td><td>{{rs core/domain/contracts/ciclo.ts :: export interface SessionStorage}}</td></tr>
