        <tr><td>LocationGateway</td><td>{{rs core/domain/contracts/index.ts :: export interface LocationGateway}}</td></tr>
        <tr><td>AuthGateway</td><td>{{rs core/domain/contracts/index.ts :: export interface AuthGateway}}</td></tr>
        <tr><td>PdfGateway</td><td>{{rs core/domain/contracts/ciclo.ts :: export interface PdfGateway}}</td></tr>
        <tr><td>SincronizacaoGateway</td><td>{{rs core/domain/contracts/ciclo.ts :: export interface SincronizacaoGateway}}</td></tr>
        <tr><td>Clock · IdGenerator</td><td>{{rs core/domain/contracts/index.ts :: export interface Clock}}</td></tr>
      </tbody>
    </table>
